# One red cell at rest in DPD solvent, periodic box 16 x 16 x 10 um.
# The cell should keep its biconcave shape, area and volume, and the
# solvent its temperature.
#
#   python3 make_data.py
#   lmp -k on g 1 -sf kk -pk kokkos newton on neigh half -in in.rest
#   python3 analyze.py

units           lj
atom_style      molecular
boundary        p p p
read_data       rest.data

# membrane (Fedosov, Caswell and Karniadakis 2010); the shape in the data
# file is the stress-free reference
bond_style      wlc/pow
bond_coeff      1 2.2 120 2                      # lmax/l0  mu0  m
angle_style     area/volume
angle_coeff     1 4900 132.87 5000 92.45 100     # ka  A0  kv  V0  kd
dihedral_style  bend
dihedral_coeff  1 6.025 0                        # kb  theta0 (degrees)

# DPD: pair_style T rc seed;  pair_coeff a gamma_par gamma_perp s_par s_perp
# types: 1 membrane, 2 solvent, 3 wall
pair_style      dpd/ext 0.0707 1.5 34387
pair_coeff      * * 4.0 40.0 0.0 0.15 0.15
pair_coeff      1 2 0.0 47.9 0.0 0.2 0.2         # membrane-solvent: drag only
special_bonds   lj 0.0 0.0 0.0

comm_modify     vel yes cutoff 3.0
neighbor        0.3 bin
neigh_modify    delay 0 every 1 check yes

group           cell type 1
group           solvent type 2
velocity        all create 0.0707 4928459 dist gaussian loop geom

fix             nve all nve

compute         shape all rbc/shape
compute         tsolv solvent temp
thermo_style    custom step c_tsolv c_shape[1][1] c_shape[1][2] c_shape[1][3] cpuremain
thermo_modify   norm no flush yes
thermo          1000
timestep        0.001

fix             out all print 1000 "$(step) $(c_tsolv:%.5f) $(c_shape[1][1]:%.4f) $(c_shape[1][2]:%.4f)" &
                file shape.txt screen no title "# step T_solvent area volume"
dump            cell cell custom 2000 cell.lammpstrj id mol xu yu zu
dump_modify     cell sort id

run             50000
write_restart   rest.restart

# A red cell in shear flow.  The walls (12 um apart) slide at -U and +U
# along x, which gives a shear rate of about 2U/H = 0.1 (714 1/s).
# Wall particles stay in place but carry the wall velocity, which the
# DPD drag passes on to the solvent; bounce-back uses the same velocity.
# The cell tilts and its membrane rotates around it (tank-treading).
#
#   python3 make_data.py
#   lmp -k on g 1 -sf kk -pk kokkos newton on neigh half -in in.shear
#   python3 analyze.py
#
# If you use this model, please cite Z. Chai et al., Biophys. J. (2026),
# https://doi.org/10.1016/j.bpj.2026.10.021.  LAMMPS prints the articles
# to cite at the end of the run and puts their BibTeX entries in the log
# file.

variable        U index 0.6                       # wall speed, must match make_data.py
variable        nrun index 250000

units           lj
atom_style      molecular
boundary        p p f
read_data       shear.data

bond_style      wlc/pow
bond_coeff      1 2.2 120 2                       # lmax/l0  mu0  m
angle_style     area/volume
angle_coeff     1 4900 132.87 5000 92.45 100      # ka  A0  kv  V0  kd
dihedral_style  bend
dihedral_coeff  1 6.025 0                         # kb  theta0 (degrees)

# types: 1 membrane, 2 solvent, 3 wall
pair_style      dpd/ext 0.0707 1.5 66019
pair_coeff      * * 4.0 40.0 0.0 0.15 0.15
pair_coeff      1 2*3 0.0 47.9 0.0 0.2 0.2        # membrane-solvent and membrane-wall
special_bonds   lj 0.0 0.0 0.0

comm_modify     vel yes cutoff 3.0
neighbor        0.3 bin
neigh_modify    delay 0 every 1 check yes exclude type 3 3

group           cell type 1
group           solvent type 2
group           mobile type 1 2
group           wall type 3
region          low block INF INF INF INF INF 1.5
region          high block INF INF INF INF 13.5 INF
group           in_low region low
group           in_high region high
group           wall_low intersect wall in_low
group           wall_high intersect wall in_high
velocity        mobile create 0.0707 51728 dist gaussian loop geom
velocity        solvent ramp vx -${U} ${U} z 1.5 13.5 sum yes units box
velocity        wall_low set -${U} 0 0
velocity        wall_high set ${U} 0 0

fix             nve mobile nve
include         walls.inc

compute         shape all rbc/shape
compute         tsolv solvent temp/profile 1 0 0 z 24
thermo_style    custom step c_tsolv c_shape[1][1] c_shape[1][2] f_walls[2] cpuremain
thermo_modify   norm no flush yes
thermo          5000
timestep        0.001

fix             out all print 1000 "$(step) $(xcm(cell,x):%.4f) $(xcm(cell,z):%.4f) $(c_shape[1][1]:%.3f) $(c_shape[1][2]:%.3f)" &
                file cell.txt screen no title "# step x_center z_center area volume"
compute         slab solvent chunk/atom bin/1d z lower 0.5 units box
fix             prof solvent ave/chunk 100 500 50000 slab vx file profile.txt
dump            cell cell custom 2000 cell.lammpstrj id mol xu yu zu
dump_modify     cell sort id

run             ${nrun}
write_restart   shear.restart
